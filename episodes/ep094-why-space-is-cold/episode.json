    {
      "who": "LEO",
      "text": "How cold is it?"
    },
    {
      "who": "MIA",
      "text": "Far away from any star, space is about minus 270 degrees Celsius. Much colder than any freezer!",
      "punch": "minus",
      "board": {
        "type": "big",
        "icon": "🧊",
        "text": "About minus 270 °C",
