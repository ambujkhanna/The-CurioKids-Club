          "items": [
            {
              "text": "Slower rumble",
              "icon": "👂",
              "cue": "rumble"
            }
          ]
        }
      }
    },
    {
      "who": "LEO",
      "text": "Is it safe to watch?"
    },
    {
      "who": "MIA",
      "text": "Here's a rule to remember: when thunder roars, go indoors! You can watch the storm safely from inside.",
      "punch": "indoors",
