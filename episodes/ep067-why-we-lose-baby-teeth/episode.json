    {
      "who": "LEO",
      "text": "Mia, why do we lose our baby teeth?",
      "board": {
        "type": "title",
        "left": {
          "icon": "img:Human_physiology/Servier/teeth-gum-child",
          "label": "Baby teeth"
        },
        "right": {
