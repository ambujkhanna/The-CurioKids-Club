        "right": {
          "label": "Grown-ups",
          "items": [
            {
              "icon": "img:Human_physiology/Servier/teeth-gum-adult",
              "text": "32 big teeth",
              "cue": "thirty"
            }
          ]
        }
      }
    },
    {
      "who": "LEO",
      "text": "When do they start falling out?"
    },
    {
      "who": "MIA",
      "text": "Often around age six. But every kid is different, so early or late is okay.",
      "board": {
        "type": "big",
        "icon": "🎂",
        "text": "Often around age 6",
        "cue": "six",
        "sub": "Early or late is okay",
        "sub_cue": "early"
      }
    },
    {
      "who": "LEO",
      "text": "So baby teeth fall out to make room for big, strong teeth!",
      "board": {
        "type": "summary",
        "rows": [
          {
            "icon": "🦷",
