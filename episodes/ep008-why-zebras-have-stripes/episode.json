            "cue": "herd"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "Do all zebras have the same stripes?"
    },
    {
      "who": "MIA",
      "text": "Nope! Every zebra's stripes are different, kind of like your fingerprints.",
      "board": {
        "type": "big",
        "icon": "🦓",
        "text": "No two the same!",
        "cue": "different",
        "sub": "Like fingerprints",
        "sub_cue": "fingerprints"
