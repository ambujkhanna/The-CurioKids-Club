    {
      "who": "MIA",
      "text": "Here's a secret! Long, long ago, people really did say the K. It sounded like \"k-nife\".",
      "punch": "secret",
      "board": {
        "type": "big",
        "icon": "📜",
        "text": "Once, K was spoken!",
        "cue": "long",
        "sub": "It sounded like \"k-nife\"",
        "sub_cue": "sounded"
      }
    },
    {
      "who": "LEO",
      "text": "Really? So what happened?"
    },
    {
      "who": "MIA",
      "text": "Over a long time, people stopped saying the K. The sound faded away, but the spelling stayed the same.",
      "board": {
        "type": "lifecycle",
        "title": "Silent K story",
        "items": [
          {
            "icon": "🗣️",
            "label": "K was said",
