  "lines": [
    {
      "who": "LEO",
      "text": "Mia, how do my ears hear things?",
      "board": {
        "type": "title",
        "left": {
          "icon": "img:Human_physiology/Servier/ear",
          "label": "Ears"
        },
        "right": {
          "icon": "🔊",
          "label": "Sounds?"
        },
        "mid": "?"
      }
    },
    {
      "who": "MIA",
      "text": "Every sound is a little wiggle in the air. Scientists call it a vibration.",
      "board": {
        "type": "big",
        "icon": "🔊",
        "text": "Sound is wiggly air",
        "cue": "wiggle",
        "sub": "Called a vibration",
        "sub_cue": "vibration"
      }
    },
    {
      "who": "LEO",
      "text": "Wiggly air? But I can't see it!"
    },
    {
      "who": "MIA",
      "text": "Nope, it's invisible! The outside of your ear is shaped like a funnel. It catches those wiggles and sends them inside.",
      "board": {
        "type": "big",
        "icon": "👂",
        "text": "Your ear catches sound",
        "cue": "funnel",
        "sub": "Then sends it inside",
        "sub_cue": "inside"
      }
    },
    {
      "who": "LEO",
      "text": "Where do they go?"
    },
    {
      "who": "MIA",
      "text": "First they hit your eardrum, a thin, stretchy skin that shakes like a tiny drum.",
      "board": {
        "type": "big",
        "icon": "img:Human_physiology/Servier/ear",
        "text": "The eardrum shakes",
        "cue": "eardrum",
        "sub": "Like a tiny drum",
        "sub_cue": "drum"
      }
    },
    {
      "who": "MIA",
      "text": "Then three tiny bones pass the shake along. One of them is the smallest bone in your whole body!",
      "punch": "smallest",
      "board": {
        "type": "big",
        "icon": "🦴",
        "text": "3 tiny bones",
        "cue": "three",
        "sub": "The smallest in your body!",
        "sub_cue": "smallest"
      }
    },
    {
      "who": "LEO",
      "text": "Whoa! What's next?"
    },
    {
      "who": "MIA",
      "text": "Next is a curly tube shaped like a snail shell. It's full of liquid and tiny hairs that wiggle too.",
      "board": {
        "type": "big",
        "icon": "🐌",
        "text": "A snail-shaped tube",
        "cue": "snail",
        "sub": "Full of tiny hairs",
        "sub_cue": "hairs"
      }
    },
    {
      "who": "MIA",
      "text": "Those tiny hairs send a message to your brain, and your brain says: that's a dog barking!",
      "board": {
        "type": "big",
        "icon": "img:Human_physiology/Servier/brain-1",
        "text": "Your brain knows!",
        "cue": "brain",
        "sub": "Woof! A dog!",
        "sub_cue": "dog"
      }
    },
    {
      "who": "LEO",
      "text": "So sound goes in my ear, to the drum, to the bones, to the snail, then my brain!",
      "board": {
        "type": "journey",
        "title": "Sound's trip",
        "traveler": "🎵",
        "items": [
          {
            "icon": "👂",
            "label": "Into ear",
            "cue": "ear"
          },
          {
            "icon": "img:Human_physiology/Servier/ear",
            "label": "Eardrum",
            "cue": "drum"
          },
          {
            "icon": "🦴",
            "label": "Tiny bones",
            "cue": "bones"
          },
          {
            "icon": "🐌",
            "label": "Snail tube",
            "cue": "snail"
          },
          {
            "icon": "🧠",
            "label": "Brain",
            "cue": "brain"
          }
        ]
      }
    },
    {
      "who": "MIA",
      "text": "Exactly! So be kind to your ears. Turn loud sounds down, and never poke things inside them.",
      "board": {
