            "cue": "spread"
          },
          {
            "label": "Bounces back to you",
            "icon": "↩️",
            "cue": "bounces"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "Is that why the colours are always in the same order?"
    },
    {
      "who": "MIA",
      "text": "Yes! Red, orange, yellow, green, blue, indigo and violet. Red is always on the outside!",
