    {
      "who": "MIA",
      "text": "A cloud is made of lots and lots of tiny drops of water, or tiny bits of ice!",
      "board": {
        "type": "picture",
        "art": "kf_cloud_drops",
        "caption": "Tiny water drops",
        "cue": "drops",
        "icon": "💧"
      }
    },
    {
      "who": "LEO",
      "text": "But water is heavy!"
    },
    {
      "who": "MIA",
      "text": "A big bucket is! But each cloud drop is super tiny, much smaller than a raindrop, and very light.",
      "punch": "tiny",
      "board": {
        "type": "big",
        "icon": "🤏",
        "text": "Super tiny and light",
        "cue": "tiny",
        "sub": "Smaller than a raindrop",
        "sub_cue": "smaller"
      }
    },
    {
      "who": "LEO",
      "text": "So what holds them up?"
    },
    {
      "who": "MIA",
      "text": "Rising air! Warm air goes up and gently lifts the tiny drops, so they fall super slowly.",
      "punch": "lifts",
      "board": {
        "type": "flow",
        "title": "Rising air",
        "packet": "💧",
        "items": [
          {
            "icon": "☀️",
