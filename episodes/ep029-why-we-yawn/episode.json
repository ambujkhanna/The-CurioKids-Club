    {
      "who": "LEO",
      "text": "Why do I yawn when you yawn?"
    },
    {
      "who": "MIA",
      "text": "Yawns are catching! Just seeing someone yawn, or even hearing about yawns, can make you yawn too.",
      "punch": "catching",
