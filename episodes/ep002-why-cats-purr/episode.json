            "cue": "nap"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "Do they ever purr for other reasons?"
    },
    {
      "who": "MIA",
      "text": "They do! Cats sometimes purr when they're nervous or not feeling well. Scientists think purring may help them feel calm.",
      "punch": "calm",
      "board": {
        "type": "big",
        "icon": "💗",
        "text": "Purring to feel calm",
        "cue": "calm",
        "sub": "Even when worried",
        "sub_cue": "nervous"
      }
    },
    {
      "who": "LEO",
      "text": "Do baby kittens purr too?"
    },
    {
      "who": "MIA",
      "text": "They do, when they're just a few days old! Kittens purr to tell their mum they're okay, and mum purrs back.",
      "board": {
        "type": "gallery",
        "title": "Kitten talk",
        "items": [
