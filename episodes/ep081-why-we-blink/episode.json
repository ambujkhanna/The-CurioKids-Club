    },
    {
      "who": "LEO",
      "text": "Do I have to remember to blink?"
    },
    {
      "who": "MIA",
      "text": "Nope! Your brain does it for you, without you even thinking. You blink every few seconds!",
      "punch": "thinking",
      "board": {
        "type": "big",
        "icon": "🧠",
        "text": "Automatic blinks",
        "cue": "brain",
        "sub": "Every few seconds",
