    {
      "who": "MIA",
      "text": "Blinking keeps your eyes wet and clean! Each blink spreads a thin layer of tears over your eyes.",
      "punch": "tears",
      "board": {
        "type": "picture",
        "art": "kf_blink",
        "caption": "Blinks spread tears",
        "cue": "tears",
