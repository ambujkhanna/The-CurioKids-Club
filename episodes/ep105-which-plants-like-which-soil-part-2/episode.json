    {
      "who": "MIA",
      "text": "Quick recap! Sandy soil drains fast, clay soil holds water, and loam is a good mix.",
      "board": {
        "type": "summary",
        "rows": [
          {
            "text": "Sandy: drains fast",
            "icon": "🏖️",
            "cue": "sandy"
          },
          {
            "text": "Clay: holds water",
            "icon": "💧",
            "cue": "clay"
