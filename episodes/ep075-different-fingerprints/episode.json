            "label": "Arch",
            "cue": "arches"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "What are fingerprints for?"
    },
    {
      "who": "MIA",
      "text": "Scientists think ridges help us grip and feel. And fun fact: koalas have fingerprints too!",
      "board": {
        "type": "big",
        "icon": "🐨",
