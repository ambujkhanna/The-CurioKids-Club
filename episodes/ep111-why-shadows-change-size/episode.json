    {
      "who": "LEO",
      "text": "Why is my shadow so long in the morning?"
    },
    {
      "who": "MIA",
      "text": "In the morning, the Sun is low. Its light comes from the side, so your shadow stretches long!",
      "punch": "stretches",
      "board": {
        "type": "big",
        "icon": "🌅",
        "text": "Low Sun = long shadow",
        "cue": "low",
        "sub": "Morning and evening",
        "sub_cue": "morning"
      }
    },
    {
      "who": "LEO",
      "text": "And at lunchtime?"
    },
    {
      "who": "MIA",
      "text": "Around midday, the Sun is high in the sky. Its light shines down from above, so your shadow is short.",
      "board": {
        "type": "big",
        "icon": "☀️",
        "text": "High Sun = short shadow",
        "cue": "high",
        "sub": "Around midday",
        "sub_cue": "midday"
      }
    },
    {
      "who": "LEO",
      "text": "So my shadow changes all day!"
    },
    {
      "who": "MIA",
      "text": "Yes! Long in the morning, short at midday, and long again in the evening.",
      "board": {
        "type": "lifecycle",
        "title": "A shadow's day",
        "items": [
          {
            "icon": "🌅",
            "label": "Morning: long",
