    {
      "who": "LEO",
      "text": "Mia, how do whales breathe?",
      "board": {
        "type": "title",
        "left": {
          "icon": "🐋",
          "label": "Whale"
        },
        "right": {
          "icon": "img:Human_physiology/Servier/healthy-lung",
