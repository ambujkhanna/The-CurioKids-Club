    {
      "who": "MIA",
      "text": "It's the air! Cutting the apple lets air reach the inside.",
      "punch": "air",
      "board": {
        "type": "big",
        "icon": "💨",
        "text": "Air gets inside",
        "cue": "air",
        "sub": "After cutting",
        "sub_cue": "cutting"
      }
    },
    {
      "who": "LEO",
      "text": "What does the air do?"
    },
    {
      "who": "MIA",
      "text": "Air has a gas called oxygen. Oxygen mixes with tiny things inside the apple, and the white part turns brown.",
      "board": {
        "type": "transform",
        "title": "A natural change",
        "from": {
          "icon": "🍏",
          "label": "White inside",
          "cue": "white"
