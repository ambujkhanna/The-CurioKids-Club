        "to": {
          "icon": "🟤",
          "label": "Brown",
          "cue": "brown"
        }
      }
    },
    {
      "who": "LEO",
      "text": "Is my apple rotten now?"
    },
    {
      "who": "MIA",
      "text": "Nope! A brown apple slice is still safe to eat. It's just a natural change.",
      "punch": "safe",
      "board": {
        "type": "big",
        "icon": "✅",
        "text": "Still safe to eat",
        "cue": "safe",
        "sub": "A natural change",
        "sub_cue": "natural"
      }
    },
    {
      "who": "LEO",
      "text": "Do other fruits turn brown too?"
    },
    {
      "who": "MIA",
      "text": "Yes! Bananas, pears and avocados turn brown too.",
