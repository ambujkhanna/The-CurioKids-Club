    {
      "who": "MIA",
      "text": "Muscles are like stretchy bands tied to your bones. When a muscle gets shorter, it pulls a bone, and you move!",
      "board": {
        "type": "body",
        "title": "Pull and move",
        "show": [
          "muscles",
          "bones"
        ],
        "labels": [
          {
            "text": "Muscle",
            "at": "muscles",
            "cue": "muscles"
          },
          {
            "text": "Bone",
            "at": "bones",
            "cue": "bone"
          },
          {
            "text": "Move!",
            "at": "leg",
            "cue": "move"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "How many muscles do I have?"
    },
    {
      "who": "MIA",
      "text": "More than six hundred! They help you smile, jump and grab.",
      "punch": "hundred",
      "board": {
        "type": "gallery",
        "title": "Over 600 muscles!",
        "items": [
          {
            "icon": "😄",
            "label": "Smile",
