            "cue": "grab"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "Can a muscle push, too?"
    },
    {
      "who": "MIA",
      "text": "Nope! Muscles only pull, so they work in teams. One bends your arm, and its partner straightens it.",
      "punch": "pull",
      "board": {
        "type": "big",
        "icon": "💪",
        "text": "Muscles work in pairs",
        "cue": "teams",
        "sub": "One bends, one straightens",
        "sub_cue": "bend"
      }
    },
    {
      "who": "LEO",
      "text": "Like a tug of war inside my arm!"
    },
    {
      "who": "MIA",
      "text": "Kind of! With a grown-up, feel your upper arm and bend your elbow. Feel that bump? That's your muscle!",
      "board": {
        "type": "big",
        "icon": "img:Human_physiology/Servier/muscle-3",
        "text": "Feel your muscle bump",
        "cue": "bump",
        "sub": "Try it with a grown-up",
        "sub_cue": "grown"
      }
    },
    {
      "who": "LEO",
      "text": "Do any muscles work by themselves?"
    },
    {
      "who": "MIA",
      "text": "Yes! Your heart is a muscle. It pumps all day and all night, even while you sleep.",
      "board": {
        "type": "body",
