    {
      "who": "LEO",
      "text": "Umbrellas? How?"
    },
    {
      "who": "MIA",
      "text": "When sweat or rain runs down your forehead, your eyebrows send it off to the sides.",
      "board": {
        "type": "flow",
        "title": "Drip, drip, away!",
        "packet": "💧",
        "items": [
