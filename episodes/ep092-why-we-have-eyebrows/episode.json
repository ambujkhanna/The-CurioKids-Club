          },
          {
            "icon": "↔️",
            "label": "To the sides",
            "cue": "sides"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "Why does that matter?"
    },
    {
      "who": "MIA",
      "text": "Sweat can sting your eyes and make it hard to see. Eyebrows help keep your eyes clear.",
      "board": {
        "type": "big",
        "icon": "👀",
        "text": "Clear eyes",
        "cue": "clear",
        "sub": "No stingy sweat",
        "sub_cue": "sting"
