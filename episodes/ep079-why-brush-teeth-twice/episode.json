    {
      "who": "LEO",
      "text": "Mia, why do we brush our teeth twice a day?",
      "board": {
        "type": "title",
        "left": {
          "icon": "🦷",
          "label": "Teeth"
        },
        "right": {
          "icon": "🪥",
