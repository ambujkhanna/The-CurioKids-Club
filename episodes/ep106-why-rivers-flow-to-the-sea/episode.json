          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "Where does it go then?"
    },
    {
      "who": "MIA",
      "text": "It flows down from the mountains, past fields and towns, all the way to the sea.",
      "board": {
        "type": "flow",
