    },
    {
      "who": "LEO",
      "text": "Is it a big river right away?"
    },
    {
      "who": "MIA",
      "text": "No! First it's a tiny stream. Little streams join together and grow into a big river.",
      "board": {
        "type": "lifecycle",
        "title": "A river grows",
        "items": [
          {
            "icon": "💧",
            "label": "Tiny stream",
