            "cue": "starch"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "Water? In a hard little seed?"
    },
    {
      "who": "DAD",
      "text": "Yep! When the kernel gets hot, that water turns into steam. Steam needs much more space, so it pushes and pushes.",
      "board": {
        "type": "steps",
        "title": "What happens",
        "items": [
          {
            "label": "Kernel gets hot",
            "icon": "🔥",
            "cue": "hot"
          },
          {
            "label": "Water turns to steam",
            "icon": "♨️",
            "cue": "steam"
          },
          {
            "label": "Steam pushes",
            "icon": "💨",
            "cue": "pushes"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "But the shell is so hard!"
    },
    {
      "who": "DAD",
      "text": "The hard shell holds the steam in, until... POP! The shell bursts open.",
      "punch": "pop",
      "board": {
        "type": "big",
