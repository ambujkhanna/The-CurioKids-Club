    {
      "who": "MIA",
      "text": "It's because of your ears! Deep inside each ear are tiny, curly tubes filled with fluid.",
      "punch": "ears",
      "board": {
        "type": "picture",
        "art": "kf_dizzy",
        "caption": "Tiny tubes of fluid",
        "cue": "tubes",
        "icon": "👂"
