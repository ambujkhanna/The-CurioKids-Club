              "cue": "stopped"
            }
          ]
        }
      }
    },
    {
      "who": "LEO",
      "text": "How do I stop feeling dizzy?"
    },
    {
      "who": "MIA",
      "text": "Just sit down and wait. Soon the fluid settles, and the dizzy feeling goes away.",
      "board": {
