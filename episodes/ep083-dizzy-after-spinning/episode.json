    },
    {
      "who": "LEO",
      "text": "Fluid? Like water?"
    },
    {
      "who": "MIA",
      "text": "A bit like water! When you move, the fluid sloshes, and your brain feels which way you're turning.",
      "board": {
        "type": "flow",
        "title": "Balance message",
        "packet": "💧",
        "items": [
          {
            "icon": "🔄",
            "label": "You move",
