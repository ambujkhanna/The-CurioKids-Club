              "icon": "🌋",
              "cue": "lava"
            }
          ]
        }
      }
    },
    {
      "who": "LEO",
      "text": "Are all eruptions big and loud?"
    },
    {
      "who": "MIA",
      "text": "No! Some volcanoes blast out clouds of ash. Others just ooze runny lava that flows like a slow, glowing river.",
      "board": {
        "type": "compare",
        "left": {
          "label": "Blast",
          "items": [
            {
              "text": "Ash clouds",
              "icon": "💥",
