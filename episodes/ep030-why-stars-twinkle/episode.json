    },
    {
      "who": "LEO",
      "text": "What do stars look like from space?"
    },
    {
      "who": "MIA",
      "text": "Astronauts in space see stars that don't twinkle at all, because there's no air up there!",
      "board": {
        "type": "big",
        "icon": "🚀",
        "text": "No air, no twinkle",
