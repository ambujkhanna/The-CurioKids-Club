          },
          {
            "icon": "💨",
            "text": "Air",
            "cue": "air"
          },
          {
            "icon": "🌳",
            "text": "Oxygen for us!",
            "cue": "oxygen"
          }
        ]
      }
    },
    {
      "who": "MIA",
      "text": "You got it! Ask a grown-up to subscribe to The Curio Kids Club for more wonders! And next time someone asks... how do plants make their food?"
