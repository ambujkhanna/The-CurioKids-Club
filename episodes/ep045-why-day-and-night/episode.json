      "who": "MIA",
      "text": "One full spin takes about twenty-four hours. That's one whole day and night!",
      "board": {
        "type": "big",
        "icon": "🕛",
        "text": "One spin = one day",
        "cue": "spin",
        "sub": "About 24 hours",
