    {
      "who": "LEO",
      "text": "So how does spinning make night?"
    },
    {
      "who": "MIA",
      "text": "The Sun can only light up one side of Earth at a time. The side facing the Sun has day. The side facing away has night.",
      "board": {
        "type": "compare",
        "left": {
          "label": "Facing Sun",
          "items": [
            {
              "text": "Daytime",
              "icon": "☀️",
