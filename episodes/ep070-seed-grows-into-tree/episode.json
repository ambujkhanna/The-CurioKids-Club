            "cue": "shoot"
          }
        ]
      }
    },
    {
      "who": "LEO",
      "text": "How does it eat when its lunchbox is empty?"
    },
    {
      "who": "MIA",
      "text": "Its leaves make food from sunlight, air and water!",
      "board": {
        "type": "big",
        "icon": "🍃",
        "text": "Leaves make food",
        "cue": "leaves",
        "sub": "From sunlight, air and water",
        "sub_cue": "sunlight"
