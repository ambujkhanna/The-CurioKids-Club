    },
    {
      "who": "LEO",
      "text": "So how does it get so big?"
    },
    {
      "who": "MIA",
      "text": "Bit by bit, year after year! The stem gets thick and woody and becomes a trunk.",
      "board": {
        "type": "big",
        "icon": "🌳",
        "text": "Year after year",
        "cue": "year",
        "sub": "The stem becomes a trunk",
        "sub_cue": "trunk"
