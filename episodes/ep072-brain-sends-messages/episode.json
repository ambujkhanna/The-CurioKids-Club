        "sub": "To every part of you",
        "sub_cue": "every"
      }
    },
    {
      "who": "LEO",
      "text": "Wires? Inside me?"
    },
    {
      "who": "MIA",
      "text": "Not real wires! Nerves are made of living cells that pass messages along super fast.",
      "board": {
        "type": "big",
        "icon": "⚡",
        "text": "Tiny, fast messages",
        "cue": "messages",
        "sub": "Passed cell to cell",
